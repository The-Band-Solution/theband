# Chave mestra usada para cifrar as credenciais das ferramentas conectadas.
#
# FR-005: a chave MUST vir do ambiente e MUST NOT residir na base de dados nem
# no repositório. FR-005a: a aplicação recusa o boot quando ela está ausente,
# em vez de operar gravando credenciais sem proteção.
#
# Gerar com:
#   mix the_band.gen_key
# ou:
#   elixir -e ':crypto.strong_rand_bytes(32) |> Base.encode64() |> IO.puts()'
THE_BAND_MASTER_KEY=

# Banco de dados. Em desenvolvimento o compose.yaml já sobe o Postgres 16.
DATABASE_URL=ecto://postgres:postgres@localhost/the_band_dev

# Segredo de sessão do Phoenix (apenas produção; em dev o gerado basta).
# Gerar com: mix phx.gen.secret
SECRET_KEY_BASE=

# Host público da aplicação (apenas produção).
PHX_HOST=
