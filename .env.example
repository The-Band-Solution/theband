# Chave mestra usada para cifrar as credenciais das ferramentas conectadas.
#
# FR-005: a chave MUST vir do ambiente e MUST NOT residir na base de dados nem
# no repositório. FR-005a: a aplicação recusa o boot quando ela está ausente,
# em vez de operar gravando credenciais sem proteção.
#
# Gerar com:
#   mix the_band.gen_key
# ou:
#   elixir -e ':crypto.strong_rand_bytes(32) |> Base.encode64() |> IO.puts()'
THE_BAND_MASTER_KEY=

# Banco de dados. Em desenvolvimento o compose.yaml já sobe o Postgres 16.
DATABASE_URL=ecto://postgres:postgres@localhost/the_band_dev

# Segredo de sessão do Phoenix (apenas produção; em dev o gerado basta).
# Gerar com: mix phx.gen.secret
SECRET_KEY_BASE=

# Host público da aplicação (apenas produção).
PHX_HOST=

# ── Ensaio da imagem de produção ────────────────────────────────────────────────
#
#   docker compose --profile producao up --build
#
# Sobe o Postgres do ensaio (banco JÁ criado — o entrypoint da imagem migra, não
# cria) e a MESMA imagem que o CD publica, com estas variáveis carregadas daqui
# pelo `env_file` do compose. Nenhuma env solta na linha de comando: o histórico
# do shell guarda tudo que se digita.
#
# A `DATABASE_URL` de cima aponta para `localhost`, que dentro do contêiner é o
# próprio contêiner — por isso o ensaio tem a sua, com o nome do serviço.
#
# Em PRODUÇÃO nada disto vale: a lista fechada do contrato manda `DATABASE_URL`,
# `SECRET_KEY_BASE`, `THE_BAND_MASTER_KEY` e `PHX_HOST` viverem no painel do
# Dokploy — nunca num arquivo, nunca no repositório.
DATABASE_URL_CONTAINER=ecto://postgres:postgres@postgres_prod/band_prod
POSTGRES_PROD_PASSWORD=postgres
POSTGRES_PROD_DB=band_prod
APP_PORT=4001

# ── A primeira conta (feature 052) ──────────────────────────────────────────────
#
# Numa instalação NOVA, com o banco vazio, a plataforma cria a organização e o
# primeiro administrador a partir daqui, no boot, depois das migrações. Só quando
# não existe administrador nenhum: reiniciar não duplica nem sobrescreve.
#
# Ausentes, a plataforma sobe assim mesmo e o log diz quais faltaram — a ausência
# não derruba o contêiner, ao contrário de DATABASE_URL.
#
# Em PRODUÇÃO, REMOVA a senha do painel depois do primeiro acesso: enquanto ela
# existir ali, é legível por quem tem acesso ao painel. Removê-la não afeta nada
# — no boot seguinte o log dirá "já existe administrador".
THE_BAND_TENANT_NOME=
THE_BAND_TENANT_SLUG=
THE_BAND_ADMIN_EMAIL=
THE_BAND_ADMIN_SENHA=
# Opcional — sem ele a conta nasce sem nome, e a pessoa o preenche em /profile.
THE_BAND_ADMIN_NOME=
