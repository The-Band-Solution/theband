#!/bin/sh
# O ambiente da release — gerado por `mix release`, que inclui este arquivo em todo comando de
# `bin/the_band`. O resto é o padrão do Elixir; o que está aqui é só a guarda abaixo.
#
# Spec 071, #1140 (A1 de `specs/071-papeis-do-banco/seguranca-1140.md`). O contêiner começa como
# root para ler a credencial que migra num arquivo só de root, e o terminal do Dokploy (`docker
# exec`) também entra como root. A distribuição Erlang é SIMÉTRICA: um nó root que se conecta ao
# nó que serve (`rpc`, `remote`) recebe e executa código do nó de `band` — medido: `id -u` dava 0 e
# o arquivo da credencial era lido. Por isso todo comando que conecta ao nó, ou o sobe, nunca roda
# como root: ele se reexecuta como `band`, sem a variável que migra no ambiente. O `eval` da
# migração, que não abre distribuição, continua root.
if [ "$(id -u)" = 0 ]; then
  case "$RELEASE_COMMAND" in
    rpc|remote|restart|stop|pid|start|start_iex|daemon|daemon_iex)
      exec env -u DATABASE_MIGRATION_URL setpriv --reuid=band --regid=band --init-groups \
        --inh-caps=-all --bounding-set=-all --no-new-privs \
        env HOME=/home/band USER=band LOGNAME=band "$0" "$@"
      ;;
  esac
fi
