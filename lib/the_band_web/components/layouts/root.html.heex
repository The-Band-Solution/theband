<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="TheBand" suffix=" · The Band" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Sem `defer`: precisa rodar antes da pintura, ou a página abre no tema errado e
          corrige depois — o piscar. É o oposto do `app.js` logo acima, que é adiado
          justamente para não bloquear. --%>
    <script phx-track-static type="text/javascript" src={~p"/assets/js/theme.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
