    {
      "id": "302d7dc9-2035-4874-9e59-596abc87289c",
      "title": "Aberturas da entrada sem tentativa em 30 minutos (abandonou)",
      "description": "R6 da spec 074: o abandono é consulta, e não é emitido. Conta as aberturas da tela de entrada cujo journey.id não chegou a um entrar_com_senha em até 30 minutos depois da própria abertura. Só aberturas com mais de 30 minutos entram.",
      "panelTypes": "table",
      "isStacked": false,
      "nullZeroValues": "zero",
      "opacity": "1",
      "timePreferance": "GLOBAL_TIME",
      "yAxisUnit": "none",
      "softMin": null,
      "softMax": null,
      "thresholds": [],
      "fillSpans": false,
      "selectedLogFields": [],
      "selectedTracesFields": [],
      "query": {
        "queryType": "clickhouse_sql",
        "id": "27f3d69a-8672-46d4-8f6f-4839e96951a2",
        "builder": {
          "queryData": [],
          "queryFormulas": []
        },
        "promql": [
          {
            "name": "A",
            "query": "",
            "legend": "",
            "disabled": false
          }
        ],
        "clickhouse_sql": [
          {
            "name": "A",
            "query": "-- R6 da spec 074: aberturas (abrir_a_entrada) cujo journey.id não aparece num entrar_com_senha\n-- em até 30 minutos DEPOIS DA PRÓPRIA abertura. Só conta aberturas com mais de 30 minutos.\n-- Sem nenhuma, a consulta não devolve linha (HAVING), e o quadro fica sem dado, e não com zero.\nSELECT 'abandonou' AS desfecho, count() AS aberturas\nFROM (\n  SELECT attributes_string['journey.id'] AS jid, min(timestamp) AS aberta\n  FROM signoz_traces.distributed_signoz_index_v3\n  WHERE attributes_string['journey.step'] = 'abrir_a_entrada'\n    AND timestamp BETWEEN {{.start_datetime}} AND {{.end_datetime}}\n  GROUP BY jid\n) AS a\nLEFT JOIN (\n  SELECT attributes_string['journey.id'] AS jid, min(timestamp) AS tentou\n  FROM signoz_traces.distributed_signoz_index_v3\n  WHERE attributes_string['journey.step'] = 'entrar_com_senha'\n    AND timestamp BETWEEN {{.start_datetime}} AND {{.end_datetime}} + INTERVAL 30 MINUTE\n  GROUP BY jid\n) AS e ON a.jid = e.jid\nWHERE a.aberta < now() - INTERVAL 30 MINUTE\n  AND (e.tentou = toDateTime64(0, 9) OR e.tentou > a.aberta + INTERVAL 30 MINUTE OR e.tentou < a.aberta)\nHAVING aberturas > 0",
            "legend": "",
            "disabled": false
          }
        ]
      }
    }
  ],
  "variables": {},
